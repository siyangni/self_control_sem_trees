Package: crimeTrajec
Type: Package
Title: Group-Based Trajectory Modeling for Longitudinal Criminology Data
Version: 0.1.0
Date: 2025-11-05
Authors@R: c(
    person("Researcher", "Name", email = "researcher@example.com",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0000-0000-0000")),
    person("Collaborator", "Name", email = "collaborator@example.com",
